# Local-only development values. Copy this file to .env and replace the
# service-role placeholder with the local key from `npx supabase status`.
ADMIN_PASSWORD=local-admin-password-change-me

BROKER_SUPPORT_SUPABASE_URL=http://127.0.0.1:54321
BROKER_SUPPORT_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

BOOKKEEPER_SUPABASE_URL=http://127.0.0.1:54321
BOOKKEEPER_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

TRAINING_SANDBOX_SUPABASE_URL=http://127.0.0.1:54321
TRAINING_SANDBOX_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

FPA_ASSESSMENT_SUPABASE_URL=http://127.0.0.1:54321
FPA_ASSESSMENT_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

PARAPLANNER_ASSESSMENT_SUPABASE_URL=http://127.0.0.1:54321
PARAPLANNER_ASSESSMENT_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
