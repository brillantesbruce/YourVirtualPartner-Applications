{
  "name": "yvp-web-apps-portal",
  "private": true,
  "workspaces": [
    "apps/training-sandbox"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && npx netlify-cli dev --framework \"#static\" --dir dist --functions ../../netlify/functions --port 8888",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:stop": "npx supabase stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4"
  }
}
